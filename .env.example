# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3000

# MyAnimeList API v2 — https://myanimelist.net/apiconfig
# Create an app to get a Client ID. The ID alone is enough for public/read-only
# data via the X-MAL-CLIENT-ID header; the secret is only needed for OAuth2
# user-list access, which this app does not implement yet.
#
# MAL sends no CORS headers, so this credential is used SERVER-SIDE ONLY.
# If MAL_CLIENT_ID is unset the app still works: MAL enrichment is skipped and
# Jikan (unofficial MAL mirror, no key required) covers characters/voice actors.
MAL_CLIENT_ID=

# Client ids are 32 hex characters. Anything else is rejected at startup with a
# warning (and reported by /api/catalog/status) rather than silently producing
# "400 Invalid client id" on every MAL call.
# MAL_CLIENT_ID_SKIP_VALIDATION=1 bypasses that check if MAL changes the format.

# Optional tuning
CACHE_TTL_DETAILS_MS=43200000
CACHE_TTL_LIST_MS=900000
JIKAN_MIN_INTERVAL_MS=400

# How long an expired cache entry stays usable as an emergency fallback. When a
# provider is failing the last good payload is served instead of an error, so an
# outage costs freshness rather than the whole page. Default 30 days.
# CACHE_STALE_GRACE_MS=2592000000
